# RaziOne Eye — web environment (copy to .env.local or .env)
#
# VITE_API_MODE: "mock" | "real"
#   mock (default) — in-memory demo dataset, no backend needed.
#   real           — fetches against /api (the Vite dev server proxies it to
#                    http://localhost:8787 — start the backend with `pnpm dev`
#                    at the repo root).
VITE_API_MODE=mock
