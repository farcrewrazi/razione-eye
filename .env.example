# RaziOne Eye — production environment.
# Copy to `.env` on the VPS and edit values. Never commit `.env`.
#
#   cp .env.example .env

# Public origin of the app, required so the API's CORS allows browser calls.
# Use your real domain (no trailing slash). Multiple origins: comma-separated.
# Example: CORS_ORIGIN=https://eye.example.com
CORS_ORIGIN=https://eye.example.com

# Frontend build mode. Must be `real` in production so the web app calls /api/*.
# (Vite bakes this in at build time — changing it requires a frontend rebuild.)
VITE_API_MODE=real

# Host-bound port for the frontend container (host Nginx reverse-proxies to this).
# Keep the 127.0.0.1 prefix so it is not exposed directly to the internet.
FRONTEND_PORT=127.0.0.1:8080
